# Optional: analytics stays off until you supply your own public PostHog project token.
# Never use a personal API key in a VITE_ variable.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
# Localhost and Vite development are excluded unless explicitly enabled for QA.
VITE_ANALYTICS_DEV=false
VITE_ANALYTICS_DISABLED=false

# Optional: your game ID from the CrazyGames developer portal, used only when publishing.
# CRAZYGAMES_GAME_ID=your-game-id
