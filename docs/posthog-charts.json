[
  {
    "name": "Daily active players",
    "description": "Unique browsers starting a run each day. Anonymous identity is per browser/device.",
    "query": {
      "kind": "InsightVizNode",
      "source": {
        "dateRange": {
          "date_from": "-30d"
        },
        "interval": "day",
        "properties": [
          {
            "key": "environment",
            "type": "event",
            "operator": "exact",
            "value": "production"
          }
        ],
        "kind": "TrendsQuery",
        "series": [
          {
            "kind": "EventsNode",
            "event": "run_started",
            "math": "dau"
          }
        ],
        "trendsFilter": {
          "display": "ActionsLineGraph",
          "showLegend": true
        }
      }
    }
  },
  {
    "name": "Runs started and completed",
    "description": "Player-runs per day. Co-op counts each participant; completed means defeated. Restarts and co-op exits are separate.",
    "query": {
      "kind": "InsightVizNode",
      "source": {
        "dateRange": {
          "date_from": "-30d"
        },
        "interval": "day",
        "properties": [
          {
            "key": "environment",
            "type": "event",
            "operator": "exact",
            "value": "production"
          }
        ],
        "kind": "TrendsQuery",
        "series": [
          {
            "kind": "EventsNode",
            "event": "run_started",
            "math": "total"
          },
          {
            "kind": "EventsNode",
            "event": "run_completed",
            "math": "total"
          },
          {
            "kind": "EventsNode",
            "event": "run_abandoned",
            "math": "total"
          }
        ],
        "trendsFilter": {
          "display": "ActionsLineGraph",
          "showLegend": true
        }
      }
    }
  },
  {
    "name": "Solo and co-op participation",
    "description": "Started player-runs by mode. A two-player co-op match counts twice.",
    "query": {
      "kind": "InsightVizNode",
      "source": {
        "dateRange": {
          "date_from": "-30d"
        },
        "interval": "day",
        "properties": [
          {
            "key": "environment",
            "type": "event",
            "operator": "exact",
            "value": "production"
          }
        ],
        "kind": "TrendsQuery",
        "series": [
          {
            "kind": "EventsNode",
            "event": "run_started",
            "math": "total"
          }
        ],
        "trendsFilter": {
          "display": "ActionsLineGraph",
          "showLegend": true
        },
        "breakdownFilter": {
          "breakdowns": [
            {
              "property": "mode",
              "type": "event"
            }
          ]
        }
      }
    }
  },
  {
    "name": "Average survival time",
    "description": "Average gameplay seconds in completed runs, excluding pauses. Does not include restarts or closed tabs.",
    "query": {
      "kind": "InsightVizNode",
      "source": {
        "dateRange": {
          "date_from": "-30d"
        },
        "interval": "day",
        "properties": [
          {
            "key": "environment",
            "type": "event",
            "operator": "exact",
            "value": "production"
          }
        ],
        "kind": "TrendsQuery",
        "series": [
          {
            "kind": "EventsNode",
            "event": "run_completed",
            "math": "avg",
            "math_property": "duration_seconds"
          }
        ],
        "trendsFilter": {
          "display": "ActionsLineGraph",
          "aggregationAxisFormat": "duration"
        }
      }
    }
  },
