  {
    "name": "Load → play → first upgrade",
    "description": "Players loading the game, starting a run and selecting an upgrade within one hour. Browser-level conversion may span multiple runs.",
    "query": {
      "kind": "InsightVizNode",
      "source": {
        "dateRange": {
          "date_from": "-30d"
        },
        "interval": "day",
        "properties": [
          {
            "key": "environment",
            "type": "event",
            "operator": "exact",
            "value": "production"
          }
        ],
        "kind": "FunnelsQuery",
        "series": [
          {
            "kind": "EventsNode",
            "event": "game_loaded"
          },
          {
            "kind": "EventsNode",
            "event": "run_started"
          },
          {
            "kind": "EventsNode",
            "event": "upgrade_selected"
          }
        ],
        "funnelsFilter": {
          "funnelOrderType": "ordered",
          "funnelWindowInterval": 1,
          "funnelWindowIntervalUnit": "hour",
          "funnelVizType": "steps"
        }
      }
    }
  }
]
