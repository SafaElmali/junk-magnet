{
  "name": "junk-magnet",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5184 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5184",
    "test": "tsx --test src/*.test.ts",
    "assets:abilities": "/Applications/Blender.app/Contents/MacOS/Blender --background --factory-startup --python scripts/build_ability_assets.py",
    "assets": "/Applications/Blender.app/Contents/MacOS/Blender --background --factory-startup --python scripts/build_assets.py",
    "assets:robots": "/Applications/Blender.app/Contents/MacOS/Blender --background --factory-startup --python scripts/build_robot_assets.py",
    "assets:discoveries": "/Applications/Blender.app/Contents/MacOS/Blender --background --factory-startup --python scripts/build_discovery_assets.py",
    "assets:bosses": "/Applications/Blender.app/Contents/MacOS/Blender --background --factory-startup --python scripts/build_boss_assets.py",
    "serve": "tsx server/index.ts",
    "start": "tsx server/index.ts",
    "test:coop": "tsx --test src/coop-session.test.ts server/coop.test.ts",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "build:worker": "tsc --noEmit -p worker/tsconfig.json && wrangler deploy --dry-run",
    "deploy:coop": "wrangler deploy",
    "test:worker": "wrangler deploy --dry-run --outdir .wrangler/test-bundle && node --test worker/runtime.test.mjs",
    "assets:drone": "/Applications/Blender.app/Contents/MacOS/Blender --background --factory-startup --python scripts/build_drone_asset.py"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.2.6",
    "@fontsource/dm-sans": "^5.2.6",
    "posthog-js": "^1.434.2",
    "three": "^0.183.0",
    "tsx": "^4.20.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260920.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/three": "^0.183.0",
    "@types/ws": "^8.18.1",
    "miniflare": "^5.20260918.0-alpha",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "wrangler": "^4.135.0"
  }
}
