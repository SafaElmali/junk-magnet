{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "junk-magnet-coop",
  "main": "worker/index.ts",
  "account_id": "YOUR_CLOUDFLARE_ACCOUNT_ID",
  "compatibility_date": "2026-09-20",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "coop.playjunkmagnet.com", "custom_domain": true }],
  "vars": {
    "ALLOWED_ORIGINS": "https://playjunkmagnet.com,https://www.playjunkmagnet.com,https://playjunkmagnet.netlify.app",
  },
  "durable_objects": {
    "bindings": [{ "name": "COOP", "class_name": "JunkMagnetCoop" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["JunkMagnetCoop"] }],
}
